# Database connection (Supabase PostgreSQL / Cloud SQL)
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres"

# Supabase Auth & JWT
SUPABASE_URL="https://YOUR_SUPABASE_PROJECT.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
JWT_SECRET_KEY="YOUR_32_BYTE_HEX_JWT_SECRET_FOR_SIGNING"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Biometric Encryption (AES-256 Key for templates at rest)
BIOMETRIC_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ML Siamese CNN Model
MODEL_PATH="app/ml/weights/siamese_cnn_socofing_v1.h5"
MODEL_CONFIDENCE_THRESHOLD=0.85
MODEL_UNCERTAIN_LOW_THRESHOLD=0.60
FAR_VALIDATION_RATE=0.001
FRR_VALIDATION_RATE=0.015
