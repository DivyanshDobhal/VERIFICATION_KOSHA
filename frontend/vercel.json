{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/download", "destination": "/download/index.html" },
    { "source": "/download/(.*)", "destination": "/download/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

